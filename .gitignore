# Supabase CLI local state — machine-specific, and where the CLI may
# write access tokens. Never commit this.
supabase/.temp/
supabase/.branches/
.env
.env.*
!.env.example

# Editors / OS
# .vscode/ is kept on purpose: Supabase generates it to enable Deno for
# supabase/functions, so the Edge Function type-checks in the editor.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store

# Node
node_modules/
